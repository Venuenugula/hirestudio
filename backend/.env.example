APP_NAME=Career Page Builder API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/career_page_builder

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT (used in later phases)
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local asset storage (MVP)
UPLOAD_DIR=./uploads
