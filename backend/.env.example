# PostgreSQL via Neon (do not commit real credentials)
# Paste the connection string from the Neon dashboard.
# Prefer the SQLAlchemy psycopg v3 form (postgresql+psycopg://...).
# Plain postgresql:// or postgres:// URLs are auto-normalized to +psycopg.
# Neon requires TLS — include sslmode=require.
#
# Example:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

APP_NAME=Career Page Builder API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT (used in later phases)
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local asset storage (MVP)
UPLOAD_DIR=./uploads
