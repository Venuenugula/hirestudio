# Leave empty for local dev (Vite proxies /api and /uploads to localhost:8000).
# In production (Vercel), set to the Render API origin with no trailing slash:
# VITE_API_BASE_URL=https://career-page-builder-api.onrender.com
VITE_API_BASE_URL=

# Temporary active company id until auth provides the tenant context.
# Leave empty to start in create-company mode (id is stored in localStorage after create).
VITE_ACTIVE_COMPANY_ID=
